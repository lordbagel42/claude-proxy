  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }

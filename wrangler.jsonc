{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "claude.raygen.dev", "custom_domain": true }],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "claude_proxy_requests" }
  ],
  "vars": {
    "UPSTREAM_BASE_URL": "https://api.anthropic.com",
    "CLAUDE_CODE_VERSION": "2.1.296"
  }
  // Secrets (set with `wrangler secret put`, or `.dev.vars` locally):
  //   CLAUDE_CODE_OAUTH_TOKEN  token from `claude setup-token`
  //   PROXY_KEY_<NAME>         one key per client; <NAME> labels analytics
  //   PROXY_API_KEYS           legacy comma-separated keys (still accepted)
}
